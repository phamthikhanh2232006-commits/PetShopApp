<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_card_white"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/tvMaDoiTra"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mã đổi trả: #DT1 (Đơn #DH000001)"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvTenSPDoiTra"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Áo thun cho chó mùa hè"
        android:textColor="@color/primary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvLyDoDoiTra"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Lý do: Không vừa size cún cưng"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvSoLuongHoan"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Số lượng hoàn: 1"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvSoTienHoan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hoàn tiền: 120.000 đ"
            android:textColor="@color/danger"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvNgayDoiTra"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="18/10/2026"
        android:textColor="@color/text_muted"
        android:textSize="11sp" />

</LinearLayout>
